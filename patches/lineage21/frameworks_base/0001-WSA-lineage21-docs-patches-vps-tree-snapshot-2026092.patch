-                                    listener.onOpNoted(sAppOpInfos[op].name, uid, packageName,
-                                            attributionTag, flags, mode);
+                                    try {
+                                        listener.onOpNoted(sAppOpInfos[op].name, uid, packageName,
+                                                attributionTag, flags, mode);
+                                    } catch (AbstractMethodError e) {
+                                        // WSA: listeners compiled against API 33 (Microsoft
