+                                        // the pre-U signature onOpNoted(int op, ...) only; the
+                                        // AbstractMethodError would kill the persistent process,
+                                        // and its restart re-runs EthernetManager.updateConfiguration
+                                        // which tears the network down for ~300 ms.
+                                        if (!invokeLegacyOnOpNoted(listener, op, uid, packageName,
+                                                attributionTag, flags, mode)) {
+                                            throw e;
+                                        }
+                                    }
                                 }
                             }
                         });
@@ -8660,6 +8673,25 @@ public class AppOpsManager {
         }
     }
 
+    /**
+     * WSA: dispatch to the pre-U {@code onOpNoted(int op, ...)} implemented by listeners built
+     * against API 33 (Microsoft SystemApp). Returns false if the listener has no such method.
+     */
+    private static boolean invokeLegacyOnOpNoted(@NonNull OnOpNotedListener listener, int op,
+            int uid, String packageName, String attributionTag, int flags, int mode) {
+        try {
+            java.lang.reflect.Method m = listener.getClass().getMethod("onOpNoted", int.class,
+                    int.class, String.class, String.class, int.class, int.class);
+            m.invoke(listener, op, uid, packageName, attributionTag, flags, mode);
+            return true;
+        } catch (NoSuchMethodException e) {
+            return false;
+        } catch (ReflectiveOperationException e) {
+            Log.e(DEBUG_LOGGING_TAG, "legacy onOpNoted failed for " + listener.getClass().getName(), e);
+            return true;
+        }
+    }
+
