# frameworks/native/services/inputflinger: separate InputTarget for HOVER_EXIT next to an OUTSIDE target of the same window.
#
# Crash (Android 16 on WSA, 07.11.2026; same code in android16-qpr2-release and main):
#   Fatal signal 6 (SIGABRT) in tid (InputDispatcher), pid (system_server)
#   addPointers - overlap with incoming pointers 0…01 in {connection=… Taskbar, dispatchMode=OUTSIDE, …}
# system_server restarts, every app restarts, `adb shell input` reports `Broken pipe (32)`.
#
# Condition (reproduced live): pointer 0 of an injected device (deviceId -1 — WSA delivers the Windows mouse as
# TOUCHSCREEN hover with this id, and `adb shell input` uses the same id) hovers over a WATCH_OUTSIDE_TOUCH window
# (Launcher3 `Taskbar`, touchable strip y 1530–1600), then ACTION_DOWN of the same device lands in another window.
# findTouchedWindowTargets first adds an OUTSIDE target for the Taskbar (findOutsideTargets) and then a HOVER_EXIT
# target for the same window with the same pointer 0 ("ACTION_DOWN causes HOVER_EXIT"). addPointerWindowTarget reuses
# the existing target by token — its hack only skips an existing HOVER_EXIT target, not an incoming one — and
# InputTarget::addPointers aborts on the overlap. Repro (07.11.2026): hover via
# app_process injector, then `input tap` elsewhere; control with hover outside the Taskbar does not crash.
#
# NOT BUILT (no build machine; native libinputflinger.so). docs/vps-todo.md §1.
--- a/services/inputflinger/dispatcher/InputDispatcher.cpp
+++ b/services/inputflinger/dispatcher/InputDispatcher.cpp
@@ -3019,7 +3019,10 @@ void InputDispatcher::DispatcherTouchState::addPointerWindowTarget(
     // input targets for hovering pointers and for touching pointers.
     // If we picked an existing input target above, but it's for HOVER_EXIT - let's use a new
     // target instead.
-    if (it != inputTargets.end() && it->dispatchMode == InputTarget::DispatchMode::HOVER_EXIT) {
+    // The same applies the other way round: a HOVER_EXIT for a window that already got ACTION_OUTSIDE for the same
+    // pointer in this event (WSA: Windows mouse hovering the Taskbar, then a DOWN elsewhere) — docs/patches/0036.
+    if (it != inputTargets.end() && (it->dispatchMode == InputTarget::DispatchMode::HOVER_EXIT ||
+                                     dispatchMode == InputTarget::DispatchMode::HOVER_EXIT)) {
         // Force the code below to create a new input target
         it = inputTargets.end();
     }
