# bionic/linker: keep the names libhoudini looks up in the linker's .symtab (Android 16+).
#
# libhoudini 14.0.0 (GoogleGame 1.2/1.3, WSA and Google Play Games PC) parses /apex/com.android.runtime/bin/linker64
# on disk and finds, by exact name, `__dl__ZL6solist` (head of the soinfo list) and `__dl__ZL12g_cfi_shadow`. From
# Android 16 the linker is built with ThinLTO, which promotes these file-local statics and renames them
# `<name>.llvm.<hash>`; Android 17 also renamed `solist` to `solist_head`. The lookup then yields offset 0, houdini
# reads the linker's ELF header as the list and dies on the first ARM mprotect():
#   SIGSEGV code 128 at libhoudini.so+0x39a0aa (`mov 0x10(%r9),%rax`, r9 = 0x00010102464c457f — "\x7fELF\x02\x01\x01")
# so every ARM app that calls mprotect() itself (Crashlytics NDK, packers like Weibo's libslib, Unity) crashes at
# start. Android 15 has the plain names and works; same houdini on A15 / A16 / A17: pass / crash / crash
# (repro: a minimal ARM program calling mprotect(), 03.11.2026).
#
# A global with an explicit asm name is neither promoted nor renamed by ThinLTO; the linker's objcopy
# --prefix-symbols=__dl_ step turns `_ZL6solist` into `__dl__ZL6solist` as before.
#
# NOT BUILT (no build machine). Applied in binary form instead — bin/linker-houdini-symbols.py writes the wanted
# names over the promoted ones in .symtab (code and .dynsym untouched), then the module is rebuilt with
# bin/patch-apex-jar.sh (/bin/linker64 inside com.android.runtime.apex, APEX_PAYLOAD_KEY = bionic/apex/
# com.android.runtime.pem, container key com.android.runtime.x509.pem/.pk8). Verified live on A16 and A17 (bind mount
# into zygote's namespace): repro passes, Weibo 16.10.3 starts (crashed before).
#
# Below: android17-release. For android16-release only the second hunk differs: `static soinfo* solist;` in
# linker_main.cpp gets the same treatment (`soinfo* solist __asm__("_ZL6solist");`).
--- a/linker/linker_main.cpp
+++ b/linker/linker_main.cpp
@@ -86,7 +86,9 @@
 /** The head of the list of all objects (including the executable and the linker itself), used for iteration. */
-static soinfo* solist_head;
+// libhoudini (ARM translation on WSA) finds the list by the symbol `__dl__ZL6solist` (pre-A17 name, internal
+// linkage); a global with an asm name keeps it under ThinLTO. docs/patches/0033.
+soinfo* solist_head __asm__("_ZL6solist");
 /** The tail of the list of all objects (including the executable and the linker itself), used for insertion. */
 static soinfo* solist_tail;
--- a/linker/linker.cpp
+++ b/linker/linker.cpp
@@ -175,1 +175,2 @@
-static CFIShadowWriter g_cfi_shadow;
+// See docs/patches/0033: libhoudini looks up `__dl__ZL12g_cfi_shadow`.
+CFIShadowWriter g_cfi_shadow __asm__("_ZL12g_cfi_shadow");
