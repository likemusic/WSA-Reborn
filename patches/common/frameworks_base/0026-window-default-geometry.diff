From 3029dfc7c2e02fbb94d12410516208b81a3c8f64 Mon Sep 17 00:00:00 2001
From: Valerij Ivashchenko <likemusicdev@gmail.com>
Date: Mon, 12 Oct 2026 21:34:23 +0000
Subject: [PATCH] 0026: WSA default window geometry - 1280x720 dp, 480x720
 portrait, landscape without orientation, no letterbox cap


New freeform windows sized and oriented as on Microsoft's WSA (12.10.2026, owner's decision: "own modifier after
Microsoft's"). Microsoft's WsaLaunchParamsModifier (windows-system_server.jar) is a copy of AOSP TaskLaunchParamsModifier
whose only difference that matters is the default window: 1280x720 dp, 480x720 dp for portrait apps, an app without an
orientation opens landscape. AOSP gives such an app portrait 412x732 dp ("phone") and caps the default size to a letterbox
of the stable area (1500x878 px on a 2560x1600 display). Fitting into the Windows work area stays with the bridge
(ShellBridge.fitToHostWorkArea), cascading and overlap avoidance with AOSP. Measured live with bin/wsa-window-geometry.sh:
Settings on ms13-stock 1618x947 px at x=471, with this patch the same 1618x947 px at x=471.
Same code in Android 14 (r75), 15, 16. Bytecode form: bin/services-0026.sh (ConstReplacePatch, InvokeRenamePatch).

Applies as is to Android 14 (r75), 15, 16 and LineageOS 21 (checked 13.10.2026); Android 17 and LineageOS 24 — 0026-window-default-geometry-a17.diff (one-line appendLog).

Change-Id: Ie9b291d775606ac8fd0b4a1d00c848d88c2f1318
---
 .../com/android/server/wm/LaunchParamsUtil.java     | 13 ++++++++-----
 .../android/server/wm/TaskLaunchParamsModifier.java |  5 +++--
 2 files changed, 11 insertions(+), 7 deletions(-)

diff --git a/services/core/java/com/android/server/wm/LaunchParamsUtil.java b/services/core/java/com/android/server/wm/LaunchParamsUtil.java
index cd071af6c..5a9373cb7 100644
--- a/services/core/java/com/android/server/wm/LaunchParamsUtil.java
+++ b/services/core/java/com/android/server/wm/LaunchParamsUtil.java
@@ -37,12 +37,13 @@ class LaunchParamsUtil {
     private static final boolean DEBUG = false;
 
     // Screen size of Nexus 5x
-    static final int DEFAULT_PORTRAIT_FREEFORM_WIDTH_DP = 412;
-    static final int DEFAULT_PORTRAIT_FREEFORM_HEIGHT_DP = 732;
+    // WSA: default window sizes of Microsoft's WsaLaunchParamsModifier.
+    static final int DEFAULT_PORTRAIT_FREEFORM_WIDTH_DP = 480;
+    static final int DEFAULT_PORTRAIT_FREEFORM_HEIGHT_DP = 720;
 
     // One of the most common tablet sizes that are small enough to fit in most large screens.
-    private static final int DEFAULT_LANDSCAPE_FREEFORM_WIDTH_DP = 1064;
-    private static final int DEFAULT_LANDSCAPE_FREEFORM_HEIGHT_DP = 600;
+    private static final int DEFAULT_LANDSCAPE_FREEFORM_WIDTH_DP = 1280;
+    private static final int DEFAULT_LANDSCAPE_FREEFORM_HEIGHT_DP = 720;
 
     private static final int DISPLAY_EDGE_OFFSET_DP = 27;
 
@@ -91,7 +92,9 @@ class LaunchParamsUtil {
         // dimension of default size is calculated to keep the same aspect ratio as the
         // displayArea's. Here we use stable bounds of displayArea because that indicates the area
         // that isn't occupied by system widgets (e.g. sysbar and navbar).
-        final int portraitHeight = Math.min(stableBounds.width(), stableBounds.height());
+        // WSA: no letterbox cap — a window on a desktop may be wider than the short side of the screen; fitting into the
+        // screen is done by TaskLaunchParamsModifier and into the Windows work area by the bridge.
+        final int portraitHeight = Math.max(stableBounds.width(), stableBounds.height());
         final int otherDimension = Math.max(stableBounds.width(), stableBounds.height());
         final int portraitWidth = (portraitHeight * portraitHeight) / otherDimension;
         final int maxWidth = (orientation == SCREEN_ORIENTATION_LANDSCAPE) ? portraitHeight
diff --git a/services/core/java/com/android/server/wm/TaskLaunchParamsModifier.java b/services/core/java/com/android/server/wm/TaskLaunchParamsModifier.java
index 3917868f2..4952b2e90 100644
--- a/services/core/java/com/android/server/wm/TaskLaunchParamsModifier.java
+++ b/services/core/java/com/android/server/wm/TaskLaunchParamsModifier.java
@@ -860,10 +860,11 @@ class TaskLaunchParamsModifier implements LaunchParamsModifier {
         }
 
         if (orientation == SCREEN_ORIENTATION_UNSPECIFIED) {
-            orientation = bounds.isEmpty() ? SCREEN_ORIENTATION_PORTRAIT
+            // WSA: an app without an orientation opens landscape, as on Microsoft's WSA.
+            orientation = bounds.isEmpty() ? SCREEN_ORIENTATION_LANDSCAPE
                     : orientationFromBounds(bounds);
             if (DEBUG) {
-                appendLog(bounds.isEmpty() ? "default-portrait"
+                appendLog(bounds.isEmpty() ? "default-landscape"
                         : "orientation-from-bounds=" + bounds);
             }
         }
