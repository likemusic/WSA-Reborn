+    private void wsaSettleVisibleTask(int taskId) {
+        if (mWsaHandler == null) {
+            mWsaHandler = new Handler(Looper.myLooper());
+        }
+        mWsaHandler.postDelayed(() -> {
+            final State state = mTasks.get(taskId);
+            if (state == null || !state.mTaskInfo.isVisible
+                    || state.mTaskInfo.getWindowingMode() != WINDOWING_MODE_FREEFORM) {
+                return;
+            }
+            final RunningTaskInfo info = state.mTaskInfo;
+            final Rect bounds = info.configuration.windowConfiguration.getBounds();
+            final SurfaceControl.Transaction t = new SurfaceControl.Transaction();
+            mWindowDecorationViewModel.onTaskChanging(info, state.mLeash, t, t);
+            t.setPosition(state.mLeash, info.positionInParent.x, info.positionInParent.y)
+                    .setWindowCrop(state.mLeash, bounds.width(), bounds.height())
+                    .show(state.mLeash)
+                    .apply();
+            Log.i(TAG, "WSA: settled visible task #" + taskId + " at " + info.positionInParent
+                    + " " + bounds.width() + "x" + bounds.height());
+        }, WSA_VISIBLE_SETTLE_MS);
+    }
