diff --git a/packages/SystemUI/src/com/android/systemui/toast/WsaToastForwarder.java b/packages/SystemUI/src/com/android/systemui/toast/WsaToastForwarder.java
new file mode 100644
index 000000000..13602ddec
--- /dev/null
+++ b/packages/SystemUI/src/com/android/systemui/toast/WsaToastForwarder.java
@@ -0,0 +1,137 @@
+/*
