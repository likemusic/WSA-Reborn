+package com.android.server.wm;
+
+/**
+ * vendor.img carries Microsoft's auto-generated RRO (framework-res__auto_generated_rro_vendor.apk),
+ * which sets config_deviceSpecificDisplayAreaPolicyProvider = this very class name. The real
+ * implementation exists only in Microsoft's closed services.jar, which we do not have - vendor.img is shared
+ * with other builds (used by neighbours) and must not be touched. Without this class
+ * DisplayAreaPolicy.Provider.fromResources() throws IllegalStateException right in the constructor of
+ * WindowManagerService - this is not caught (unlike config_deviceSpecificSystemServices),
+ * and system_server falls into an endless reboot loop. We delegate to the default behaviour.
+ */
+public final class WsaDisplayAreaPolicyProvider implements DisplayAreaPolicy.Provider {
+    public WsaDisplayAreaPolicyProvider() {
+    }
+
+    @Override
+    public DisplayAreaPolicy instantiate(WindowManagerService wmService, DisplayContent content,
+            RootDisplayArea root, DisplayArea.Tokens imeContainer) {
+        return new DisplayAreaPolicy.DefaultProvider().instantiate(
+                wmService, content, root, imeContainer);
+    }
+}
