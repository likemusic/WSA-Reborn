+        // service-connectivity; here it is done in the source (docs/patches/0004, Android 13 port:
+        // maybeValidateEthernetTransport does not exist yet in Android 13), 11.10.2026.
     }
 
     private boolean checkUseRestrictedNetworksPermission() {
