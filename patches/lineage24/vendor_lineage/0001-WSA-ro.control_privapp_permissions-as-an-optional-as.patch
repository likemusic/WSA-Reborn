From edab620c47c01d360149ba598bb75008fd345fcd Mon Sep 17 00:00:00 2001
From: Valerij Ivashchenko <likemusicdev@gmail.com>
Date: Wed, 7 Oct 2026 23:10:12 +0000
Subject: [PATCH] WSA: ro.control_privapp_permissions as an optional assignment
 (lineage21/lineage22 series, ported to LineageOS 23.2)

Change-Id: I595ace0ba971f289d5ae0151bbb778dd51b3acaf
---
 config/common.mk | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/config/common.mk b/config/common.mk
index d1a2dbb..1d944ff 100644
--- a/config/common.mk
+++ b/config/common.mk
@@ -101,7 +101,7 @@ PRODUCT_COPY_FILES += \
 
 # Enforce privapp-permissions whitelist
 PRODUCT_PRODUCT_PROPERTIES += \
-    ro.control_privapp_permissions=enforce
+    ro.control_privapp_permissions?=enforce
 
 ifneq ($(TARGET_DISABLE_LINEAGE_SDK), true)
 # Lineage SDK
