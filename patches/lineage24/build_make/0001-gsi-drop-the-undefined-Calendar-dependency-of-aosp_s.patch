From 0f4aa188d36d4d12dca5e9974b7a6d537a2b81ec Mon Sep 17 00:00:00 2001
From: Valerij Ivashchenko <likemusicdev@gmail.com>
Date: Fri, 9 Oct 2026 23:15:22 +0000
Subject: [PATCH] gsi: drop the undefined Calendar dependency of
 aosp_system_image (LineageOS ships Etar)

Change-Id: I18a0582dc00f715c7af838dc4d89dbc542f8c543
---
 target/product/gsi/Android.bp | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/target/product/gsi/Android.bp b/target/product/gsi/Android.bp
index 8fd7928..5b0830a 100644
--- a/target/product/gsi/Android.bp
+++ b/target/product/gsi/Android.bp
@@ -201,7 +201,8 @@ android_system_image {
         "preinstalled-packages-platform-telephony-system-ext.xml",
 
         // handheld_product
-        "Calendar",
+        // LineageOS ships Etar instead of AOSP Calendar and has no "Calendar" module: Soong analysis
+        // fails on this undefined dependency for every product, even though aosp_system_image is not built.
         "Contacts",
         "DeskClock",
         "Gallery2",
-- 
2.43.0

