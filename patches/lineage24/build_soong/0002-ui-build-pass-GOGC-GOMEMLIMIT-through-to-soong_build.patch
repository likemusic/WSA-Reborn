From e8ec2547ebb00ad6b7087257fefd6f430a2e9ed0 Mon Sep 17 00:00:00 2001
From: Valerij Ivashchenko <likemusicdev@gmail.com>
Date: Fri, 9 Oct 2026 23:36:44 +0000
Subject: [PATCH 2/2] ui/build: pass GOGC/GOMEMLIMIT through to soong_build
 (build-machine tweak for ~16 GB of RAM)

Change-Id: I93d32dc76456b1dcb686504a366f291e4ae51015
---
 ui/build/soong.go | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/ui/build/soong.go b/ui/build/soong.go
index 4521b4a..171cc40 100644
--- a/ui/build/soong.go
+++ b/ui/build/soong.go
@@ -230,6 +230,13 @@ func (pb PrimaryBuilderFactory) primaryBuilderInvocation(config Config) bootstra
 		// https://github.com/golang/proposal/blob/master/design/24543-non-cooperative-preemption.md
 		invocationEnv["GODEBUG"] = "asyncpreemptoff=1"
 	}
+	// Build-machine tweak, not a platform patch: on ~16 GB of RAM the A17 analysis runs out of memory —
+	// pass the Go GC settings through to soong_build, which is started with env -i.
+	for _, k := range []string{"GOGC", "GOMEMLIMIT"} {
+		if v, ok := os.LookupEnv(k); ok {
+			invocationEnv[k] = v
+		}
+	}
 
 	var allArgs []string
 	allArgs = append(allArgs, pb.specificArgs...)
-- 
2.43.0

