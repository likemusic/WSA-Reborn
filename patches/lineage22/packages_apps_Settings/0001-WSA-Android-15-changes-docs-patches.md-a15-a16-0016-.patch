From f7541b11cf77ceff0b615889d1c7824c56e48e87 Mon Sep 17 00:00:00 2001
From: Valerij Ivashchenko <603401+likemusic@users.noreply.github.com>
Date: Wed, 7 Oct 2026 21:54:15 +0000
Subject: [PATCH] WSA: Android 15 changes (docs/patches.md, a15 + a16/0016,
 a16/0017), 2026-10-01

Change-Id: Iff7c64cbb98e8509317a447432a06f0dbec375c1
---
 AndroidManifest.xml | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/AndroidManifest.xml b/AndroidManifest.xml
index 3b74b93..1f9762a 100644
--- a/AndroidManifest.xml
+++ b/AndroidManifest.xml
@@ -3179,6 +3179,22 @@
                        android:value="true" />
         </activity>
 
+        <!-- WSA: Microsoft SystemApp (com.microsoft.windows.systemapp,
+             SettingsRedirectionHandler.setDeveloperMode) expects the class name
+             Settings$DevelopmentSettingsDashboardActivity (a naming convention newer than the one AOSP
+             had at the time of this LineageOS fork - "Dashboard"
+             in the class name of the activity itself, not only the fragment). Without the alias
+             SystemApp crashes with IllegalArgumentException on EVERY attempt
+             to sync the Developer Options state with Windows, never getting to
+             network setup. Found 2026-09-18. -->
+        <activity-alias
+            android:name="Settings$DevelopmentSettingsDashboardActivity"
+            android:targetActivity="Settings$DevelopmentSettingsActivity"
+            android:label="@string/development_settings_title"
+            android:icon="@drawable/ic_settings_development"
+            android:exported="true">
+        </activity-alias>
+
         <activity
             android:name="Settings$PrintSettingsActivity"
             android:label="@string/print_settings"
-- 
2.43.0

