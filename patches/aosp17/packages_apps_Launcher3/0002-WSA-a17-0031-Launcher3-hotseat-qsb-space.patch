From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Valerij Ivashchenko <likemusicdev@gmail.com>
Date: Wed, 28 Oct 2026 12:00:00 +0000
Subject: [PATCH] WSA a17/0031: Launcher3 - hotseat_qsb_space_default 16 dp (the search bar covered the top of the hotseat icons with a taskbar)

---
diff --git a/res/values/config.xml b/res/values/config.xml
--- a/res/values/config.xml
+++ b/res/values/config.xml
@@ -69,7 +69,10 @@
     <!-- Scalable Grid configuration -->
     <!-- This is a float because it is converted to dp later in DeviceProfile -->
     <dimen name="hotseat_bar_bottom_space_default">48</dimen>
-    <dimen name="hotseat_qsb_space_default">0</dimen>
+    <!-- WSA: with a taskbar the search bar (OseWidgetView) sits on top of the hotseat, hotseatQsbSpace apart; no grid
+         sets it, and at 0 the fallback "Search" pill (drawn over its shadow too) covers the top of the hotseat icons.
+         Applied on the own host as the static RRO device/microsoft/wsa_x86_64/WsaLauncher3Fix. -->
+    <dimen name="hotseat_qsb_space_default">16</dimen>

     <!-- Whether to enable background preloading of task thumbnails. -->
     <bool name="config_enableTaskSnapshotPreloading">true</bool>
