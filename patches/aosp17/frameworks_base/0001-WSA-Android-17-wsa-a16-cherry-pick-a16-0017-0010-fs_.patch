@@ -510,6 +510,19 @@ class WebViewUpdateServiceImpl2 {
             Slog.w(TAG, "Default WebView package (" + mDefaultProvider.packageName + ") not found");
         }
 
+        // WSA: the default provider comes from a config overlay (e.g. GApps for Android 13 declares
+        // com.google.android.webview as isFallback) and may be absent from the image. Android 14
+        // (WebViewUpdateServiceImpl) then took any valid provider; do the same instead of leaving
+        // the system without WebView (Google sign-in crashes with MissingWebViewPackageException).
+        for (ProviderAndPackageInfo candidate : getValidWebViewPackagesAndInfos()) {
+            List<UserPackage> userPackages =
+                    mSystemInterface.getPackageInfoForProviderAllUsers(candidate.provider);
+            if (isInstalledAndEnabledForAllUsers(userPackages)) {
+                Slog.w(TAG, "Default WebView package missing, using " + candidate.provider.packageName);
+                return candidate.packageInfo;
+            }
+        }
+
         // This should never happen during normal operation (only with modified system images).
         Counter.logIncrement("webview.value_webview_not_usable_for_all_users_counter");
         mAnyWebViewInstalled = false;
