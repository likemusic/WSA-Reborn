From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Valerij Ivashchenko <likemusicdev@gmail.com>
Date: Thu, 15 Oct 2026 12:00:00 +0000
Subject: [PATCH] WSA headless: dmaheap backend for gralloc4 without a GPU node (docs/own-host.md)

---
diff --git a/Android.bp b/Android.bp
index d044e7d..af5421d 100644
--- a/Android.bp
+++ b/Android.bp
@@ -40,6 +40,7 @@ filegroup {
         "backend_mock.c",
         "drv.c",
         "drv_array_helpers.c",
+        "dmaheap.c",
         "drv_helpers.c",
         "dumb_driver.c",
         "i915.c",
@@ -323,3 +324,16 @@ cc_library_shared {
     defaults: ["minigbm_cros_gralloc0_defaults"],
     shared_libs: ["libminigbm_gralloc_arcvm"],
 }
+
+// No GPU node (software rendering: SwiftShader + ANGLE): linear buffers from /dev/dma_heap/system.
+// Static, with static libc++, so that the allocator and the mapper drop into a vendor partition of
+// an older release (VNDK v33) without extra files.
+cc_library_static {
+    name: "libminigbm_gralloc_dmaheap",
+    defaults: ["minigbm_cros_gralloc_library_defaults"],
+    cflags: [
+        "-DDRV_DMAHEAP",
+        "-DHAS_DMABUF_SYSTEM_HEAP",
+    ],
+    stl: "libc++_static",
+}
diff --git a/cros_gralloc/cros_gralloc_driver.cc b/cros_gralloc/cros_gralloc_driver.cc
index cb8b94b..fc694a9 100644
--- a/cros_gralloc/cros_gralloc_driver.cc
+++ b/cros_gralloc/cros_gralloc_driver.cc
@@ -148,6 +148,17 @@ static struct driver *init_try_nodes()
 			return drv;
 	}
 
+#ifdef DRV_DMAHEAP
+	// No GPU node at all (software rendering): linear buffers from the system dma-buf heap.
+	int fd = open("/dev/dma_heap/system", O_RDONLY | O_CLOEXEC);
+	if (fd >= 0) {
+		drv = drv_create(fd);
+		if (drv)
+			return drv;
+		close(fd);
+	}
+#endif
+
 	return nullptr;
 }
 
@@ -158,15 +169,23 @@ static void drv_destroy_and_close(struct driver *drv)
 	close(fd);
 }
 
-static bool is_running_with_software_rendering()
+static bool is_running_with_software_rendering(struct driver *drv)
 {
 	const char *vulkan_driver = drv_get_os_option("ro.hardware.vulkan");
-	return (vulkan_driver != nullptr && strstr(vulkan_driver, "pastel") != nullptr);
+	if (vulkan_driver != nullptr && strstr(vulkan_driver, "pastel") != nullptr)
+		return true;
+#ifdef DRV_DMAHEAP
+	// No GPU node at all: whatever renders is software, whatever the Vulkan driver is called
+	// (WSA keeps the name ranchu for SwiftShader dropped in place of its own driver).
+	if (drv != nullptr && strcmp(drv_get_name(drv), "dmaheap") == 0)
+		return true;
+#endif
+	return false;
 }
 
 cros_gralloc_driver::cros_gralloc_driver()
     : drv_(init_try_nodes(), drv_destroy_and_close),
-      is_running_with_software_rendering_(is_running_with_software_rendering())
+      is_running_with_software_rendering_(is_running_with_software_rendering(drv_.get()))
 {
 }
 
diff --git a/cros_gralloc/gralloc4/Android.bp b/cros_gralloc/gralloc4/Android.bp
index 73588f7..dbf3122 100644
--- a/cros_gralloc/gralloc4/Android.bp
+++ b/cros_gralloc/gralloc4/Android.bp
@@ -172,3 +172,26 @@ cc_library_shared {
         },
     },
 }
+
+// No GPU node (software rendering): see libminigbm_gralloc_dmaheap. --exclude-libs keeps the static libc++ (and
+// minigbm) symbols out of the dynamic table: otherwise the shared libc++ that the HIDL libraries pull in binds to our
+// copy at load time and aborts in ios_base::Init with std::bad_cast (checked live 14.10.2026).
+cc_binary {
+    name: "android.hardware.graphics.allocator@4.0-service.minigbm_dmaheap",
+    defaults: ["minigbm_gralloc4_allocator_defaults"],
+    static_libs: ["libminigbm_gralloc_dmaheap"],
+    stl: "libc++_static",
+    ldflags: ["-Wl,--exclude-libs,ALL"],
+    vintf_fragment_modules: ["android.hardware.graphics.allocator@4.0.xml"],
+    init_rc: ["android.hardware.graphics.allocator@4.0-service.minigbm_dmaheap.rc"],
+}
+
+cc_library_shared {
+    name: "android.hardware.graphics.mapper@4.0-impl.minigbm_dmaheap",
+    defaults: ["minigbm_gralloc4_common_defaults"],
+    static_libs: ["libminigbm_gralloc_dmaheap"],
+    stl: "libc++_static",
+    ldflags: ["-Wl,--exclude-libs,ALL"],
+    vintf_fragment_modules: ["android.hardware.graphics.mapper@4.0.xml"],
+    srcs: [":minigbm_gralloc4_mapper_files"],
+}
diff --git a/cros_gralloc/gralloc4/android.hardware.graphics.allocator@4.0-service.minigbm_dmaheap.rc b/cros_gralloc/gralloc4/android.hardware.graphics.allocator@4.0-service.minigbm_dmaheap.rc
new file mode 100644
