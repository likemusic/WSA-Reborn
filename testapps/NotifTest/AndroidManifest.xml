<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.wsalineage.notiftest">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application android:label="NotifTest" android:allowBackup="false">
        <!-- In the launcher so that the "Apps" channel creates a shortcut for the app in the Windows Start menu. -->
        <activity android:name=".MainActivity" android:exported="true" android:label="NotifTest">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".ActionReceiver" android:exported="true" />
    </application>
</manifest>
