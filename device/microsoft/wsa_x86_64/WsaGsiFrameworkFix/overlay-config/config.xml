<config>
    <!-- Immutable overlays must precede mutable ones -->
    <overlay package="com.android.systemui.gsi.overlay" mutable="false" enabled="true" />
    <!-- Path A, two framework-res fixes, both against Microsoft's overlay in vendor:
         config_deviceSpecificDisplayAreaPolicyProvider is cleared (otherwise WindowManagerService
         looks for the WsaDisplayAreaPolicyProvider class, which the prebuilt GSI does not have) and
         config_enableWallpaperService is set back to true (otherwise SystemUI dies with an NPE in
         WallpaperManager and crash-loops together with launcher3).
         WARNING: the package name here must match the apk manifest in /system_ext/overlay.
         On a mismatch zygote dies parsing this file with IllegalStateException
         "overlay ... not present in partition", and boot does not even start
         (caught 24.09.2026 when the overlay was renamed). -->
    <overlay package="com.wsa.gsi.frameworkfix" mutable="false" enabled="true" />

    <!-- Mutable overlays -->
</config>
