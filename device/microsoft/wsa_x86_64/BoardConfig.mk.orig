# Board configuration for Windows Subsystem for Android, x86_64.
#
# Based on BoardConfigGsiCommon: the image must be generic to work with
# a FOREIGN vendor (it stays Microsoft's, see docs/treble-vendor-compatibility.md).

TARGET_ARCH := x86_64
TARGET_ARCH_VARIANT := x86_64
TARGET_CPU_ABI := x86_64

# The second architecture is required: the WSA image has 32-bit components, and libhoudini
# translates ARM apps of both bitnesses.
TARGET_2ND_ARCH := x86
TARGET_2ND_ARCH_VARIANT := x86_64
TARGET_2ND_CPU_ABI := x86

include build/make/target/board/BoardConfigGsiCommon.mk

# Not LineageOS code but "plumbing" for Soong (PATH_OVERRIDE_SOONG etc.) —
# without it Android.bp parsing fails on vendor/lineage/build/soong/Android.bp
# EVEN for products that inherit nothing from vendor/lineage: Soong
# parses every Android.bp in the tree unconditionally. For the LineageOS target this
# was pulled in implicitly through its own inheritance chain; for the pure
# AOSP target (aosp_wsa_x86_64, added 13.09.2026) it has to be explicit. Nothing of
# LineageOS code ends up in the final image because of this.
-include vendor/lineage/config/BoardConfigSoong.mk

# GSI deliberately clears these types (lines 38-39 of BoardConfigGsiCommon) because it
# puts product and system_ext INSIDE system.img. WSA mounts them as separate
# disks — SCSI=0:0:0:2 and :3 in vendor/etc/fstab.1.windows — so we set the types
# explicitly and get separate images.
BOARD_PRODUCTIMAGE_FILE_SYSTEM_TYPE := ext4
BOARD_SYSTEM_EXTIMAGE_FILE_SYSTEM_TYPE := ext4

# Inode headroom via BOARD_*IMAGE_EXTFS_INODE_COUNT does NOT work here: without a fixed
# BOARD_*IMAGE_PARTITION_SIZE the image is built in use_dynamic_partition_size mode, and
# build_image.py after the first pass recomputes the inode count as "used + 0.2 %"
# (checked 22.09.2026: 8192 in system_ext_image_info.txt → 64 inodes in the image, 3 free).
# Headroom for Microsoft files is added by bin/transplant-a14.sh (growing the image by block groups).

# Same reason: GSI mounts product and system_ext inside the system image
# (system/product, system/system_ext). For separate partitions the paths must be
# top-level, otherwise the build refuses to produce separate images.
TARGET_COPY_OUT_PRODUCT := product
TARGET_COPY_OUT_SYSTEM_EXT := system_ext

# ARM translator blobs (device/microsoft/wsa-houdini, bin/extract-houdini-blobs.sh) are ELF files in
# PRODUCT_COPY_FILES; the build forbids that unless explicitly allowed.
ifneq ($(wildcard device/microsoft/wsa-houdini/houdini.mk),)
BUILD_BROKEN_ELF_PREBUILT_PRODUCT_COPY_FILES := true
endif

# The kernel is Microsoft's; we neither build nor replace it.
TARGET_NO_KERNEL := true
TARGET_NO_BOOTLOADER := true
TARGET_NO_RECOVERY := true

# Glue for versioned sepolicy compatibility with Microsoft's vendor:
# vendor_sepolicy.cil (vendor.img) ALREADY has rules like
# (allow init_33_0 gskserver_exec_33_0 ...) for the proprietary HAL bridges
# windows.services.graphics/windows.services.rcm — but the binding of the attribute
# gskserver_exec_33_0 to the real type gskserver_exec is normally generated by
# Microsoft's own PLATFORM build process, which we do not have. Without it
# `init` gets avc: denied on getattr of these executables and cannot
# start them — found 15.09.2026 via a real on-device test.
SYSTEM_EXT_PRIVATE_SEPOLICY_DIRS += device/microsoft/wsa_x86_64/sepolicy

# The control target aosp_wsa_x86_64 is built from the LineageOS tree, and its SystemUI (also from that
# tree) requires lineage-sdk services. Their labels live in device/lineage/sepolicy, and
# build/make/core/config.mk pulls them in only under `ifneq ($(LINEAGE_BUILD),)` — for the AOSP target the variable
# is empty, so system_server got `avc: denied { add } … name=lineageglobalactions …
# tcontext=u:object_r:default_android_service:s0`, services were not published and SystemUI crash-looped
# (22.09.2026, the fourth layer of the same dependency; the first three are in aosp_wsa_x86_64.mk).
# The vanilla AOSP tree has no device/lineage directory — and needs none: SystemUI there is plain
# and does not ask for lineage-sdk services. The condition makes the file usable for both trees.
ifeq ($(TARGET_PRODUCT),aosp_wsa_x86_64)
ifneq ($(wildcard device/lineage/sepolicy/common/private),)
SYSTEM_EXT_PUBLIC_SEPOLICY_DIRS  += device/lineage/sepolicy/common/public
SYSTEM_EXT_PRIVATE_SEPOLICY_DIRS += device/lineage/sepolicy/common/private
endif
endif
